{
  "name": "empasy-homepage",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://www.empasy.com",
  "type": "module",
  "scripts": {
    "predeploy": "npm run build:ssg",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "copy:pages": "node scripts/copy-files.js",
    "build": "vite build && cpy CNAME dist/ && npm run copy:pages",
    "build:ssg": "npm run build && react-snap",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sooro-io/react-gtm-module": "^3.0.1",
    "animejs": "^3.2.2",
    "gh-pages": "^6.3.0",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "photoswipe": "^5.4.4",
    "rc-slider": "^11.1.5",
    "react": "^18.3.1",
    "react-countdown": "^2.3.6",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.0.2",
    "react-modal-video": "^2.0.2",
    "react-photoswipe-gallery": "^3.0.2",
    "react-router-dom": "^6.26.1",
    "react-scroll-parallax": "^3.4.5",
    "react-share": "^5.2.2",
    "sass": "^1.77.8",
    "swiper": "^11.1.9",
    "tawk-react": "^0.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "cpy-cli": "^5.0.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "react-ga": "^3.3.1",
    "react-snap": "^1.23.0",
    "vite": "^5.4.19"
  },
  "reactSnap": {
    "source": "dist",
    "inlineCss": true,
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "skipThirdPartyRequests": true,
    "crawl": true,
    "include": [
      "/",
      "/ko",
      "/en",
      "/jp",
      "/hydra",
      "/ko/hydra",
      "/en/hydra",
      "/jp/hydra",
      "/syncboot",
      "/ko/syncboot",
      "/en/syncboot",
      "/jp/syncboot",
      "/synceta",
      "/ko/synceta",
      "/en/synceta",
      "/jp/synceta",
      "/syncapim",
      "/ko/syncapim",
      "/en/syncapim",
      "/jp/syncapim",
      "/synccms",
      "/ko/synccms",
      "/en/synccms",
      "/jp/synccms",
      "/syncshop",
      "/ko/syncshop",
      "/en/syncshop",
      "/jp/syncshop",
      "/logistics",
      "/ko/logistics",
      "/en/logistics",
      "/jp/logistics",
      "/use-cases",
      "/ko/use-cases",
      "/en/use-cases",
      "/jp/use-cases",
      "/company",
      "/ko/company",
      "/en/company",
      "/jp/company",
      "/contact",
      "/ko/contact",
      "/en/contact",
      "/jp/contact"
    ]
  }
}